{
  "name": "noahark",
  "version": "0.1.0",
  "private": true,
  "description": "NoahArk — multi-tenant business-management platform foundation (SG/MY/ID)",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "e2e": "turbo run e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @noahark/db db:generate",
    "db:migrate": "pnpm --filter @noahark/db db:migrate",
    "db:migrate:deploy": "pnpm --filter @noahark/db db:migrate:deploy",
    "db:validate": "pnpm --filter @noahark/db db:validate",
    "db:seed": "pnpm --filter @noahark/db db:seed",
    "clean": "turbo run clean && rimraf node_modules .turbo"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "turbo": "2.10.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
