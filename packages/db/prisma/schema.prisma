// NoahArk — Phase 1 foundation schema.
// Only tenancy, identity, RBAC, audit, approvals, jobs/outbox, files and
// settings are modelled here. No CRM/accounting/payroll/tax business entities
// and no statutory formulas — see docs/PHASE_01_FOUNDATION.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums (deliberately restricted — SG/MY/ID only, per CLAUDE.md scope)
// ---------------------------------------------------------------------------

enum Jurisdiction {
  SG
  MY
  ID
}

enum Currency {
  SGD
  MYR
  IDR
}

enum Language {
  EN
  MS
  ID
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum LegalEntityStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalDecisionAction {
  APPROVE
  REJECT
  CANCEL
}

enum AuditActorType {
  USER
  SYSTEM
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum JobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD
}

enum FileStatus {
  ACTIVE
  DELETED
  QUARANTINED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum CustomFieldDataType {
  STRING
  /// DEPRECATED (Phase 2A): ambiguous — a JS `number` is IEEE-754 binary
  /// floating point, which must never represent a monetary value (ADR-71).
  /// Retained ONLY so pre-existing rows written under the Phase 1 foundation
  /// mechanism remain valid; Phase 2 typed values must use INTEGER or
  /// DECIMAL instead, enforced by `custom_field_value_phase2_typed_check`.
  NUMBER
  BOOLEAN
  DATE
  /// Phase 2A additions. MULTI_SELECT is deliberately excluded — no
  /// requirement demonstrated, and it would force either an array column or
  /// a join table (Prompt 0R decision V-11).
  INTEGER
  DECIMAL
  SINGLE_SELECT
}

// ---------------------------------------------------------------------------
// Phase 2 — shared parties & catalog enums
// ---------------------------------------------------------------------------

enum PartyType {
  ORGANISATION
  INDIVIDUAL
}

enum PartyAddressType {
  BILLING
  SHIPPING
  REGISTERED
  GENERAL
}

/// Shared lifecycle for tenant-level masters and per-legal-entity
/// assignments/roles. There is deliberately no DELETED member — Phase 2
/// introduces no hard-delete path (no DELETE grant is issued to
/// `noahark_app` on any Phase 2 business table).
enum PartyStatus {
  ACTIVE
  ARCHIVED
}

enum AssignmentStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum CatalogItemType {
  PRODUCT
  SERVICE
}

// ---------------------------------------------------------------------------
// Tenant & legal entity
// ---------------------------------------------------------------------------

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  entitlements           TenantEntitlement[]
  settings               TenantSetting[]
  legalEntities          LegalEntity[]
  memberships            TenantMembership[]
  legalEntityMembers     LegalEntityMembership[]
  businessUnits          BusinessUnit[]
  departments            Department[]
  teams                  Team[]
  branches               Branch[]
  warehouses             Warehouse[]
  costCentres            CostCentre[]
  roles                  Role[]
  rolePermissions        RolePermission[]
  membershipRoles        MembershipRole[]
  fieldPolicies          FieldPolicy[]
  approvalPolicies       ApprovalPolicy[]
  approvalSteps          ApprovalStep[]
  approvalRequests       ApprovalRequest[]
  approvalDecisions      ApprovalDecision[]
  auditEvents            AuditEvent[]
  outboxEvents           OutboxEvent[]
  notifications          Notification[]
  notificationPrefs      NotificationPreference[]
  fileObjects            FileObject[]
  attachments            Attachment[]
  customFieldDefs        CustomFieldDefinition[]
  customFieldValues      CustomFieldValue[]
  idempotencyKeys        IdempotencyKey[]
  demoApprovalSubjects   DemoApprovalSubject[]
  invitations            MembershipInvitation[]
  // Phase 2 — shared parties & catalog
  parties                Party[]
  partyContacts          PartyContact[]
  partyAddresses         PartyAddress[]
  partyAssignments       PartyLegalEntityAssignment[]
  customerRoles          CustomerRole[]
  vendorRoles            VendorRole[]
  catalogCategories      CatalogCategory[]
  unitsOfMeasure         UnitOfMeasure[]
  catalogItems           CatalogItem[]
  catalogItemAssignments CatalogItemLegalEntityAssignment[]
  priceLists             PriceList[]
  priceListAssignments   PriceListLegalEntityAssignment[]
  priceListEntries       PriceListEntry[]

  @@map("tenant")
}

/**
 * Foundation for SaaS plan enforcement (billing itself is deferred — AD-2).
 * A module the tenant hasn't been entitled to (or has had disabled) is
 * rejected server-side with MODULE_DISABLED, independent of the caller's
 * permissions — see entitlementService.ts.
 */
model TenantEntitlement {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  moduleKey String   @map("module_key")
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@map("tenant_entitlement")
}

model TenantSetting {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  key           String
  value         Json
  updatedByUser String?  @map("updated_by_user_id")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_setting")
}

model LegalEntity {
  id                   String            @id @default(cuid())
  tenantId             String            @map("tenant_id")
  name                 String
  jurisdiction         Jurisdiction
  functionalCurrency   Currency          @map("functional_currency")
  timeZone             String            @map("time_zone")
  defaultLanguage      Language          @default(EN) @map("default_language")
  status               LegalEntityStatus @default(ACTIVE)
  // Registered identifiers are jurisdiction-specific and intentionally opaque
  // (UEN / SSM+TIN / NPWP+NITKU) — no format validation beyond non-empty,
  // per REGULATORY_SOURCE_REGISTER.md (formats not yet primary-sourced).
  registeredIdentifier String?           @map("registered_identifier")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant                 Tenant                             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settings               LegalEntitySetting[]
  legalEntityMembers     LegalEntityMembership[]
  businessUnits          BusinessUnit[]
  departments            Department[]
  teams                  Team[]
  branches               Branch[]
  warehouses             Warehouse[]
  costCentres            CostCentre[]
  membershipRoles        MembershipRole[]
  approvalPolicies       ApprovalPolicy[]
  approvalRequests       ApprovalRequest[]
  auditEvents            AuditEvent[]
  outboxEvents           OutboxEvent[]
  notifications          Notification[]
  fileObjects            FileObject[]
  customFieldDefs        CustomFieldDefinition[]
  customFieldValues      CustomFieldValue[]
  demoApprovalSubjects   DemoApprovalSubject[]
  // Phase 2 — shared parties & catalog
  partyAssignments       PartyLegalEntityAssignment[]
  customerRoles          CustomerRole[]
  vendorRoles            VendorRole[]
  catalogItemAssignments CatalogItemLegalEntityAssignment[]
  priceListAssignments   PriceListLegalEntityAssignment[]
  priceListEntries       PriceListEntry[]
  // Phase 2A audit remediation (ADR-73): managing legal entity for shared
  // masters. Assignments remain the extra read-visibility grant; this
  // relation is mutation ownership. ON DELETE NO ACTION so a standalone
  // legal-entity DELETE is rejected while it owns masters, without racing
  // tenant-level CASCADE used by test-fixture teardown. Deactivating an
  // owner (status) never deletes the master.
  ownedParties           Party[]                            @relation("PartyOwner")
  ownedCatalogItems      CatalogItem[]                      @relation("CatalogItemOwner")
  ownedPriceLists        PriceList[]                        @relation("PriceListOwner")

  // Phase 2A: referenced target for the composite foreign keys that make a
  // cross-tenant legal-entity reference structurally impossible.
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("legal_entity")
}

model LegalEntitySetting {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  legalEntityId String   @map("legal_entity_id")
  key           String
  value         Json
  updatedByUser String?  @map("updated_by_user_id")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  @@unique([legalEntityId, key])
  @@index([tenantId, legalEntityId])
  @@map("legal_entity_setting")
}

// --- organisational structure (thin, structural only in Phase 1) -----------

model BusinessUnit {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  legalEntityId String   @map("legal_entity_id")
  name          String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  departments Department[]

  @@index([tenantId, legalEntityId])
  @@map("business_unit")
}

model Department {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  legalEntityId  String   @map("legal_entity_id")
  businessUnitId String   @map("business_unit_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity  LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  teams        Team[]

  @@index([tenantId, legalEntityId])
  @@map("department")
}

model Team {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  legalEntityId String   @map("legal_entity_id")
  departmentId  String   @map("department_id")
  name          String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  department  Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, legalEntityId])
  @@map("team")
}

model Branch {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  legalEntityId String   @map("legal_entity_id")
  name          String
  address       Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  warehouses  Warehouse[]

  @@index([tenantId, legalEntityId])
  @@map("branch")
}

model Warehouse {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  legalEntityId String   @map("legal_entity_id")
  branchId      String?  @map("branch_id")
  name          String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  branch      Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId, legalEntityId])
  @@map("warehouse")
}

model CostCentre {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  legalEntityId String   @map("legal_entity_id")
  code          String
  name          String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  @@unique([legalEntityId, code])
  @@index([tenantId, legalEntityId])
  @@map("cost_centre")
}

// ---------------------------------------------------------------------------
// Identity & authentication (Auth.js-compatible + NoahArk extensions)
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     DateTime? @map("email_verified") @db.Timestamptz(3)
  name              String?
  image             String?
  preferredLanguage Language? @map("preferred_language")
  isDisabled        Boolean   @default(false) @map("is_disabled")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  credential                UserCredential?
  accounts                  Account[]
  sessions                  Session[]
  tenantMemberships         TenantMembership[]
  legalEntityMembers        LegalEntityMembership[]
  grantedLegalEntityMembers LegalEntityMembership[]  @relation("LegalEntityMembershipGrantedBy")
  assignedMembershipRoles   MembershipRole[]         @relation("MembershipRoleAssignedBy")
  submittedApprovals        ApprovalRequest[]        @relation("ApprovalRequestSubmittedBy")
  approvalDecisions         ApprovalDecision[]
  auditEventsAsActor        AuditEvent[]             @relation("AuditEventActor")
  notifications             Notification[]
  notificationPrefs         NotificationPreference[]
  uploadedFiles             FileObject[]
  attachmentsCreated        Attachment[]
  demoApprovalSubjects      DemoApprovalSubject[]
  mfaCredential             MfaCredential?
  invitationsSent           MembershipInvitation[]   @relation("MembershipInvitationInvitedBy")

  @@map("app_user")
}

// Password hashes live in a table separate from User so ordinary user
// lookups/joins can never accidentally surface a hash.
model UserCredential {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  passwordHash String   @map("password_hash")
  algorithm    String   @default("argon2id")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credential")
}

// F-3B (Phase 1B): TOTP MFA. Global identity table (like UserCredential) —
// no RLS, no tenant_id, mirrors why passwords live in their own table:
// ordinary user lookups/joins can never accidentally surface the secret.
// `secretEncrypted` is AES-256-GCM-encrypted at rest (packages/auth's
// mfaSecretCrypto.ts) using a key DERIVED from AUTH_SECRET (key
// separation, no second required secret env var — same pattern as the
// file-signing key in fileServiceWrapper.ts). Recovery codes are stored
// ONLY as SHA-256 hashes, one row per code, each single-use.
model MfaCredential {
  id                  String    @id @default(cuid())
  userId              String    @unique @map("user_id")
  secretEncrypted     String    @map("secret_encrypted")
  // Null until the enrolment flow's confirmation step succeeds — an
  // unconfirmed secret does not gate sign-in (see mfaService.ts).
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamptz(3)
  // N-1 (Phase 1D): TOTP replay protection. The RFC 4226 HOTP counter
  // (floor(unixSeconds / 30)) of the most recently ACCEPTED code — never
  // the raw code/secret itself, just an integer position in the moving
  // window. A code at or before this counter can never be accepted again,
  // even if it is still within the ±1 step drift window verifyTotp allows
  // — see mfaService.ts's atomic conditional update (WHERE
  // last_used_totp_counter IS NULL OR < counter), which also makes two
  // concurrent submissions of the SAME valid code resolve to exactly one
  // success. Null until the first successful TOTP verification.
  lastUsedTotpCounter Int?      @map("last_used_totp_counter")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes MfaRecoveryCode[]

  @@map("mfa_credential")
}

model MfaRecoveryCode {
  id              String    @id @default(cuid())
  mfaCredentialId String    @map("mfa_credential_id")
  codeHash        String    @unique @map("code_hash")
  usedAt          DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  mfaCredential MfaCredential @relation(fields: [mfaCredentialId], references: [id], onDelete: Cascade)

  @@index([mfaCredentialId])
  @@map("mfa_recovery_code")
}

// Auth.js adapter contract — unused by credentials auth today, kept so SSO
// (AD-4) can be added later without a schema change.
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Session {
  id                  String   @id @default(cuid())
  sessionToken        String   @unique @map("session_token")
  userId              String   @map("user_id")
  expires             DateTime @db.Timestamptz(3)
  // Last-selected context — a convenience hint only. The server ALWAYS
  // re-validates tenant/legal-entity membership on every request; these
  // fields are never trusted as the authorization source of truth.
  activeTenantId      String?  @map("active_tenant_id")
  activeLegalEntityId String?  @map("active_legal_entity_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // P1E-4 (Phase 1F): supports the worker's expired-session retention sweep
  // (apps/web/lib/retentionMaintenance.ts).
  @@index([expires])
  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
  // P1E-4 (Phase 1F): supports the worker's expired-token retention sweep
  // (covers both email-verification and MFA-challenge tokens — see
  // apps/web/lib/verificationTokenMaintenance.ts).
  @@index([expires])
  @@map("verification_token")
}

// F-9 (Phase 1B.1): shared, PostgreSQL-backed auth rate limiting — replaces
// the in-memory limiter, which did not work across multiple application
// instances. Fixed-window counters keyed by (dimension, key_hash,
// window_start): `windowStart` is the window's own boundary
// (floor(now / WINDOW_MS) * WINDOW_MS), so concurrent requests in the same
// window race on a single row via `INSERT ... ON CONFLICT DO UPDATE
// attempt_count = attempt_count + 1` (see rateLimiter.ts) — atomic,
// concurrency-safe, no read-then-write race. `keyHash` is SHA-256 of the
// normalised email or IP, never the raw value, so a database read never
// discloses which specific account/address is near its limit in plaintext.
// Global (not tenant-owned) — same identity-adjacent classification as
// VerificationToken; no RLS.
model AuthRateLimitBucket {
  id           String             @id @default(cuid())
  dimension    RateLimitDimension
  keyHash      String             @map("key_hash")
  windowStart  DateTime           @map("window_start") @db.Timestamptz(3)
  attemptCount Int                @default(0) @map("attempt_count")
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([dimension, keyHash, windowStart])
  @@index([windowStart])
  @@map("auth_rate_limit_bucket")
}

enum RateLimitDimension {
  EMAIL
  IP
  // N-1 (Phase 1D): distinct MFA-challenge buckets — deliberately NOT
  // sharing EMAIL/IP's counters, so a caller who has already exhausted
  // their PASSWORD attempt budget (which stops before MFA is ever reached)
  // doesn't confusingly bleed into the MFA counters, and vice versa.
  // MFA_ACCOUNT is keyed by a hash of the userId (not email — the MFA
  // challenge flow already has a resolved userId from the challenge
  // token, unlike the password step which only has an email), so a fresh
  // challenge token obtained after a correct password re-submission can
  // never reset this counter — the limit follows the ACCOUNT, not the
  // token.
  MFA_ACCOUNT
  MFA_IP
}

/**
 * F-14/E2E (Phase 1B.1): test-only capture of "sent" emails, so an E2E
 * suite driving the real product (not direct system-client writes) can
 * retrieve a verification/invitation link the same way a real inbox would
 * receive it. Never written to or read from unless BOTH `NODE_ENV !==
 * "production"` AND `TEST_NOTIFICATION_CAPTURE === "1"` — see
 * apps/web/lib/testEmailCapture.ts, the ONLY code path that touches this
 * table. A production deployment (NODE_ENV=production) can never activate
 * this even if TEST_NOTIFICATION_CAPTURE were mistakenly set — the check is
 * doubled, not just env-var-gated. Global (no tenant_id) because email
 * verification/invitation happen before any tenant is selected; no RLS
 * policy exists for it — same posture as AuthRateLimitBucket above.
 */
model TestEmailCapture {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([to, createdAt])
  // P1E-4 (Phase 1F): supports the worker's test-capture retention sweep
  // (a plain createdAt scan, not scoped by `to` — the compound index above
  // is for the read endpoint's own lookup, not this).
  @@index([createdAt])
  @@map("test_email_capture")
}

// ---------------------------------------------------------------------------
// Memberships
// ---------------------------------------------------------------------------

model TenantMembership {
  id              String           @id @default(cuid())
  tenantId        String           @map("tenant_id")
  userId          String           @map("user_id")
  status          MembershipStatus @default(ACTIVE)
  invitedByUserId String?          @map("invited_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipRoles MembershipRole[]

  @@unique([tenantId, userId])
  @@map("tenant_membership")
}

// F-3E (Phase 1B): membership invitation. Tenant-scoped (RLS: simple
// tenant-only group, no legal_entity_id column — an invite MAY carry an
// intended legal-entity grant, applied only on acceptance, but the
// invitation row itself is tenant-wide). Deliberately references the
// intended role/legal-entity by id rather than embedding a snapshot of
// permissions — acceptance re-validates the inviter still holds the
// authority to grant them (roleService/legalEntityService's existing
// self-escalation guards), so a role edited/removed between invite and
// accept cannot silently grant something the inviter no longer controls.
model MembershipInvitation {
  id                    String           @id @default(cuid())
  tenantId              String           @map("tenant_id")
  email                 String
  tokenHash             String           @unique @map("token_hash")
  invitedByUserId       String           @map("invited_by_user_id")
  // Tenant-wide role to assign on acceptance — optional (an admin may
  // invite someone with no role yet, to be assigned later).
  intendedRoleId        String?          @map("intended_role_id")
  // Legal entity to grant access to on acceptance — optional.
  intendedLegalEntityId String?          @map("intended_legal_entity_id")
  status                InvitationStatus @default(PENDING)
  expiresAt             DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt            DateTime?        @map("accepted_at") @db.Timestamptz(3)
  revokedAt             DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("MembershipInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, email])
  // P1E-4 (Phase 1F): supports the worker's terminal-invitation retention
  // sweep (apps/web/lib/retentionMaintenance.ts).
  @@index([status, expiresAt])
  @@map("membership_invitation")
}

// Legal-entity access is granted independently of tenant membership and is
// NEVER implied by it (non-transitive) — LEGAL_ENTITY_ARCHITECTURE.md §5.
model LegalEntityMembership {
  id              String           @id @default(cuid())
  tenantId        String           @map("tenant_id")
  legalEntityId   String           @map("legal_entity_id")
  userId          String           @map("user_id")
  status          MembershipStatus @default(ACTIVE)
  grantedByUserId String?          @map("granted_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User?       @relation("LegalEntityMembershipGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@unique([legalEntityId, userId])
  @@index([tenantId, legalEntityId])
  @@map("legal_entity_membership")
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

// Global, platform-maintained catalogue — not tenant-scoped. Seeded only;
// the application role has SELECT-only privilege on this table (see the RLS
// & grants migration).
model Permission {
  id          String @id @default(cuid())
  key         String @unique
  category    String
  description String

  rolePermissions RolePermission[]
  fieldPolicies   FieldPolicy[]

  @@map("permission")
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  key         String
  name        String
  description String?
  // System roles are seeded per tenant at provisioning time and are
  // protected from permission edits / deletion (app-layer AND a DB-level
  // WITH CHECK policy — see the RLS migration).
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]
  approvalSteps   ApprovalStep[]

  @@unique([tenantId, key])
  @@map("role")
}

model RolePermission {
  id           String @id @default(cuid())
  tenantId     String @map("tenant_id")
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([tenantId])
  @@map("role_permission")
}

// Assigns a Role to a TenantMembership. When legalEntityId is null the role
// applies tenant-wide (subject to the separate legal-entity ACCESS check);
// when set, the role only grants permissions within that legal entity.
model MembershipRole {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")
  tenantMembershipId String   @map("tenant_membership_id")
  roleId             String   @map("role_id")
  legalEntityId      String?  @map("legal_entity_id")
  assignedByUserId   String   @map("assigned_by_user_id")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantMembership TenantMembership @relation(fields: [tenantMembershipId], references: [id], onDelete: Cascade)
  role             Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  legalEntity      LegalEntity?     @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  assignedBy       User             @relation("MembershipRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, legalEntityId])
  @@map("membership_role")
}

// Foundation for field-level access control (HR/payroll will register real
// protected fields in later phases — none exist yet in Phase 1).
model FieldPolicy {
  id                   String  @id @default(cuid())
  tenantId             String? @map("tenant_id")
  entityType           String  @map("entity_type")
  fieldName            String  @map("field_name")
  requiredPermissionId String  @map("required_permission_id")
  description          String?

  tenant             Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requiredPermission Permission @relation(fields: [requiredPermissionId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("field_policy")
}

// ---------------------------------------------------------------------------
// Approval foundation (generic — no business workflows)
// ---------------------------------------------------------------------------

model ApprovalPolicy {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  legalEntityId     String?  @map("legal_entity_id")
  subjectType       String   @map("subject_type")
  name              String
  isActive          Boolean  @default(true) @map("is_active")
  // F-18 (Phase 1B): default-DENIED. A submitter who also holds the
  // approver role for a step cannot approve/reject their own request
  // unless the policy explicitly opts in — segregation of duties by
  // default, not by accident of role assignment.
  allowSelfApproval Boolean  @default(false) @map("allow_self_approval")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity?      @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  steps       ApprovalStep[]
  requests    ApprovalRequest[]

  @@index([tenantId, legalEntityId])
  @@map("approval_policy")
}

model ApprovalStep {
  id               String  @id @default(cuid())
  tenantId         String  @map("tenant_id")
  approvalPolicyId String  @map("approval_policy_id")
  stepOrder        Int     @map("step_order")
  approverRoleId   String  @map("approver_role_id")
  name             String?

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvalPolicy ApprovalPolicy @relation(fields: [approvalPolicyId], references: [id], onDelete: Cascade)
  approverRole   Role           @relation(fields: [approverRoleId], references: [id], onDelete: Restrict)

  @@unique([approvalPolicyId, stepOrder])
  @@index([tenantId])
  @@map("approval_step")
}

model ApprovalRequest {
  id                String                @id @default(cuid())
  tenantId          String                @map("tenant_id")
  legalEntityId     String?               @map("legal_entity_id")
  approvalPolicyId  String                @map("approval_policy_id")
  subjectType       String                @map("subject_type")
  subjectId         String                @map("subject_id")
  status            ApprovalRequestStatus @default(PENDING)
  currentStepOrder  Int                   @default(1) @map("current_step_order")
  submittedByUserId String                @map("submitted_by_user_id")
  submittedAt       DateTime              @default(now()) @map("submitted_at") @db.Timestamptz(3)
  decidedAt         DateTime?             @map("decided_at") @db.Timestamptz(3)
  // Optimistic concurrency — every state transition must supply the version
  // it read; a stale write is rejected rather than silently overwritten.
  version           Int                   @default(1)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity    LegalEntity?       @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  approvalPolicy ApprovalPolicy     @relation(fields: [approvalPolicyId], references: [id], onDelete: Restrict)
  submittedBy    User               @relation("ApprovalRequestSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  decisions      ApprovalDecision[]

  @@index([subjectType, subjectId])
  @@index([tenantId, legalEntityId])
  @@map("approval_request")
}

model ApprovalDecision {
  id                String                 @id @default(cuid())
  tenantId          String                 @map("tenant_id")
  approvalRequestId String                 @map("approval_request_id")
  stepOrder         Int                    @map("step_order")
  action            ApprovalDecisionAction
  actorUserId       String                 @map("actor_user_id")
  comment           String?
  decidedAt         DateTime               @default(now()) @map("decided_at") @db.Timestamptz(3)

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  actor           User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  // At most one recorded decision per step — prevents duplicate approval at
  // the database level, not just in application logic.
  @@unique([approvalRequestId, stepOrder])
  @@index([tenantId])
  @@map("approval_decision")
}

// Neutral, non-business resource used only to exercise the approval engine
// end-to-end (sign-in → submit → approve/reject) in the admin UI and tests.
model DemoApprovalSubject {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  legalEntityId   String?  @map("legal_entity_id")
  title           String
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  createdBy   User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, legalEntityId])
  @@map("demo_approval_subject")
}

// ---------------------------------------------------------------------------
// Audit (append-only, hash-chained)
// ---------------------------------------------------------------------------

model AuditEvent {
  id            String         @id @default(cuid())
  // Nullable: sign-in/sign-out/failed-login events happen before a tenant is
  // selected and are not tenant-owned. These form their own hash chain
  // (chain key = "platform") distinct from each tenant's chain — see
  // packages/audit's auditWriter. Every other audited action IS tenant-owned
  // and always sets this.
  tenantId      String?        @map("tenant_id")
  legalEntityId String?        @map("legal_entity_id")
  actorUserId   String?        @map("actor_user_id")
  actorType     AuditActorType @default(USER) @map("actor_type")
  action        String
  entityType    String         @map("entity_type")
  entityId      String?        @map("entity_id")
  beforeData    Json?          @map("before_data")
  afterData     Json?          @map("after_data")
  requestId     String?        @map("request_id")
  ipAddress     String?        @map("ip_address")
  userAgent     String?        @map("user_agent")
  outcome       AuditOutcome   @default(SUCCESS)
  // F-2/F-6 (Phase 1B): explicit chain identity + monotonic position, so the
  // predecessor is looked up by (chainKey, sequence) rather than `createdAt
  // DESC` — timestamps at TIMESTAMP(3) precision tie routinely under any
  // real concurrency, which made the old lookup non-deterministic and able
  // to fork the chain. `chainKey` is the tenantId for a tenant's chain, or
  // the literal "__platform__" for pre-tenant-selection events (mirrors the
  // RLS policy's IS NOT DISTINCT FROM tenantId matching). `sequence` is
  // allocated 1, 2, 3, ... per chainKey while holding the same advisory
  // lock that already serializes writers — see packages/audit's hashChain
  // and apps/web's auditService.
  chainKey      String         @map("chain_key")
  sequence      BigInt
  // Hash chain — prevHash links to the previous event's hash for this
  // chain; hash covers this row's own content INCLUDING chainKey+sequence.
  // No UPDATE/DELETE grant exists for the app role, enforced again by a
  // block trigger — see the RLS & constraints migration. The trigger has no
  // role bypass for ordinary application/worker roles, but the table owner
  // can still disable it (documented residual risk — see
  // docs/PHASE_01_IMPLEMENTATION.md "Audit integrity boundary").
  prevHash      String?        @map("prev_hash")
  hash          String
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  // F-16: deliberately NOT Cascade/SetNull. The append-only trigger already
  // makes both impossible in practice (proven: deleting a user or tenant
  // referenced by any audit event is rejected by the trigger, not by these
  // FKs) — declaring Cascade/SetNull here was misleading schema metadata
  // that promised behaviour the database structurally refuses to perform.
  // Restrict makes the real constraint explicit: a tenant or user that has
  // ever produced an audit event can never be hard-deleted while that event
  // exists. Lawful erasure/retention must use a lifecycle state (e.g.
  // User.isDisabled, a future Tenant closure status) rather than deletion —
  // see docs/PHASE_01_IMPLEMENTATION.md "Audit retention and erasure".
  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  legalEntity LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  actor       User?        @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([chainKey, sequence])
  @@index([tenantId, createdAt])
  @@map("audit_event")
}

// ---------------------------------------------------------------------------
// Jobs, outbox, notifications
// ---------------------------------------------------------------------------

model OutboxEvent {
  id             String       @id @default(cuid())
  tenantId       String       @map("tenant_id")
  legalEntityId  String?      @map("legal_entity_id")
  eventType      String       @map("event_type")
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  // F-19 (Phase 1B.1): same lease design as BackgroundJob — see its comment.
  leaseExpiresAt DateTime?    @map("lease_expires_at") @db.Timestamptz(3)
  heartbeatAt    DateTime?    @map("heartbeat_at") @db.Timestamptz(3)
  lockedAt       DateTime?    @map("locked_at") @db.Timestamptz(3)
  lockedBy       String?      @map("locked_by")
  lastError      String?      @map("last_error")
  correlationId  String?      @map("correlation_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt    DateTime?    @map("processed_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([tenantId, legalEntityId])
  @@map("outbox_event")
}

model BackgroundJob {
  id             String    @id @default(cuid())
  tenantId       String?   @map("tenant_id")
  legalEntityId  String?   @map("legal_entity_id")
  jobType        String    @map("job_type")
  payload        Json
  status         JobStatus @default(PENDING)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  runAt          DateTime  @default(now()) @map("run_at") @db.Timestamptz(3)
  // F-19 (Phase 1B.1): durable lease fields. `lockedAt`/`lockedBy` are the
  // lease's acquired-at/owner (names kept for migration continuity — see
  // queue.ts's doc comment). `leaseExpiresAt` bounds how long a claim is
  // honoured before a reaper may reclaim it (crash recovery); `heartbeatAt`
  // lets a genuinely still-running handler extend its own lease for
  // long-running work without losing ownership.
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  heartbeatAt    DateTime? @map("heartbeat_at") @db.Timestamptz(3)
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy       String?   @map("locked_by")
  lastError      String?   @map("last_error")
  correlationId  String?   @map("correlation_id")
  idempotencyKey String?   @unique @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, runAt])
  @@index([status, leaseExpiresAt])
  @@index([tenantId, legalEntityId])
  // P1E-4 (Phase 1F): supports the worker's terminal-job (SUCCEEDED/DEAD)
  // retention sweep (apps/web/lib/retentionMaintenance.ts).
  @@index([status, updatedAt])
  @@map("background_job")
}

model Notification {
  id              String              @id @default(cuid())
  tenantId        String              @map("tenant_id")
  legalEntityId   String?             @map("legal_entity_id")
  recipientUserId String              @map("recipient_user_id")
  channel         NotificationChannel @default(IN_APP)
  type            String
  title           String
  body            String
  readAt          DateTime?           @map("read_at") @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  recipient   User         @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt])
  @@index([tenantId, legalEntityId])
  @@map("notification")
}

model NotificationPreference {
  id       String              @id @default(cuid())
  tenantId String              @map("tenant_id")
  userId   String              @map("user_id")
  channel  NotificationChannel
  type     String
  enabled  Boolean             @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, channel, type])
  @@map("notification_preference")
}

// ---------------------------------------------------------------------------
// Files & attachments
// ---------------------------------------------------------------------------

model FileObject {
  id               String     @id @default(cuid())
  tenantId         String     @map("tenant_id")
  legalEntityId    String?    @map("legal_entity_id")
  storageKey       String     @unique @map("storage_key")
  originalFilename String     @map("original_filename")
  mimeType         String     @map("mime_type")
  sizeBytes        Int        @map("size_bytes")
  sha256           String
  uploadedByUserId String     @map("uploaded_by_user_id")
  status           FileStatus @default(ACTIVE)
  // F-15 (Phase 1B.1): bumped on every content replacement — a signed URL's
  // signature covers this value, so ANY replacement immediately invalidates
  // every previously-issued URL for this file, not just ones issued before
  // a status change.
  version          Int        @default(1)
  // Explicit revocation independent of status — lets an operator invalidate
  // outstanding signed URLs (e.g. suspected leak) without soft-deleting or
  // quarantining the file itself. NULL = not explicitly revoked.
  revokedAt        DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(3)
  // P1E-4 (Phase 1F): set by the worker's storage-purge retention sweep
  // (apps/web/lib/retentionMaintenance.ts's purgeDeletedFileObjectStorage)
  // once the PHYSICAL storage object has been removed — the file_object
  // row itself is never deleted by that sweep. Without this marker, the
  // sweep's own eligibility query (status=DELETED, deletedAt < cutoff)
  // would keep matching the same already-purged row forever, silently
  // re-attempting a no-op delete every cycle rather than actually skipping
  // it — caught by this feature's own idempotency test.
  storagePurgedAt  DateTime?  @map("storage_purged_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  uploadedBy  User         @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  attachments Attachment[]

  @@index([tenantId, legalEntityId])
  // P1E-4 (Phase 1F): supports the worker's deleted-file storage-purge
  // sweep (apps/web/lib/retentionMaintenance.ts) — only the physical
  // storage object is removed by that sweep, never this row.
  @@index([status, deletedAt, storagePurgedAt])
  @@map("file_object")
}

model Attachment {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  fileObjectId    String   @map("file_object_id")
  ownerEntityType String   @map("owner_entity_type")
  ownerEntityId   String   @map("owner_entity_id")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileObject FileObject @relation(fields: [fileObjectId], references: [id], onDelete: Cascade)
  createdBy  User       @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([ownerEntityType, ownerEntityId])
  @@index([tenantId])
  @@map("attachment")
}

// ---------------------------------------------------------------------------
// Custom fields
//
// Phase 2 attaches these tables to real business masters, so entityType is
// a fail-closed ALLOWLIST (ADR-73) rather than the Phase 2A denylist that
// independent audit F-3 showed was bypassable by whitespace and unenumerated
// auth-adjacent names. Canonical values are lowercase snake_case exact
// matches; leading/trailing whitespace and case/plural variants are
// rejected. demo_approval_subject is retained as the only legitimate
// legacy target and is NOT referentially enforced.
// ---------------------------------------------------------------------------

model CustomFieldDefinition {
  id            String              @id @default(cuid())
  tenantId      String              @map("tenant_id")
  legalEntityId String?             @map("legal_entity_id")
  /// Canonical allowlisted target (trimmed, exact case). Immutable once
  /// values exist — see `custom_field_definition_immutability_trg`.
  entityType    String              @map("entity_type")
  key           String
  label         String
  /// Immutable once values exist (same trigger as entityType).
  dataType      CustomFieldDataType @map("data_type")
  isRequired    Boolean             @default(false) @map("is_required")
  options       Json?
  // Phase 2A additions.
  isActive      Boolean             @default(true) @map("is_active")
  displayOrder  Int                 @default(0) @map("display_order")
  version       Int                 @default(1)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity?       @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  values      CustomFieldValue[]

  @@unique([tenantId, entityType, key])
  @@unique([id, tenantId])
  @@map("custom_field_definition")
}

/// Phase 2A (expand step of expand/migrate/contract). The Phase 1 foundation
/// stored every value in the untyped `value Json` column. JSON numbers
/// deserialize as IEEE-754 doubles in every mainstream parser, which is
/// incompatible with the exact-decimal contract (ADR-71) — so Phase 2 values
/// use TYPED columns instead, with database-enforced agreement between the
/// populated column and the definition's `dataType`.
///
/// `value` is retained and merely relaxed to NULLable so pre-existing
/// foundation rows keep working untouched. It is NOT dropped in Phase 2; the
/// contract step (dropping `value` once no legacy row remains) is deferred to
/// a later phase. New Phase 2 writes are barred from `value` by
/// `custom_field_value_phase2_typed_check`.
///
/// Polymorphic `(entity_type, entity_id)` integrity is database-enforced by
/// `custom_field_value_target_integrity_trg` (ADR-73 / independent audit F-6):
/// an explicit CASE over the allowlist proves the target exists, has the
/// stated type, and belongs to the same tenant and stated legal entity.
/// There is no dynamic SQL on untrusted entityType.
model CustomFieldValue {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  /// Mandatory for every Phase 2 target type (enforced by
  /// `custom_field_value_phase2_typed_check`), so values inherit dual-axis
  /// RLS instead of the Phase 1 tenant-only policy. NULL only for the
  /// legacy `demo_approval_subject` target.
  legalEntityId String?   @map("legal_entity_id")
  definitionId  String    @map("definition_id")
  /// Must equal the definition's entityType and the allowlist exactly.
  entityType    String    @map("entity_type")
  entityId      String    @map("entity_id")
  /// Legacy Phase 1 untyped storage — retained, never written by Phase 2.
  value         Json?
  // Phase 2A typed storage. Exactly one is populated for a Phase 2 row, and
  // it must match the definition's dataType — both database-enforced.
  valueText     String?   @map("value_text")
  valueInteger  Int?      @map("value_integer")
  valueDecimal  Decimal?  @map("value_decimal") @db.Decimal(23, 6)
  valueBoolean  Boolean?  @map("value_boolean")
  valueDate     DateTime? @map("value_date") @db.Date
  valueOption   String?   @map("value_option")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity?          @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  definition  CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, entityId])
  @@index([tenantId])
  @@index([entityType, entityId])
  @@map("custom_field_value")
}

// ---------------------------------------------------------------------------
// API idempotency
// ---------------------------------------------------------------------------

model IdempotencyKey {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("idempotency_key")
}

// ---------------------------------------------------------------------------
// Phase 2 - Shared parties (CRM / Purchasing counterparties)
//
// One tenant-owned Party master; "customer" and "vendor" are LEGAL-ENTITY
// roles hung off an explicit assignment, never separate masters (ADR-71).
// That is what lets a single organisation be both a customer of the SG entity
// and a vendor of the MY entity without duplicating its identity, while
// keeping every commercial term legally separated per entity
// (LEGAL_ENTITY_ARCHITECTURE.md sections 3 and 4).
//
// The master remains tenant-level. `ownerLegalEntityId` (ADR-73) is the
// managing legal entity that may INSERT/UPDATE shared fields; assignments
// grant additional READ visibility to other entities of the same tenant.
// An assigned non-owner cannot mutate the master. Bootstrap: the owner may
// read the newly created master before the first assignment ("owner-visible
// unassigned master pending atomic assignment"). P2B still creates master +
// first assignment in one transaction.
// ---------------------------------------------------------------------------

model Party {
  id                 String      @id @default(cuid())
  tenantId           String      @map("tenant_id")
  /// Managing legal entity. Composite FK with tenantId makes a cross-tenant
  /// owner structurally impossible. Controls mutation; not dual-axis
  /// isolation — assigned non-owners may still READ.
  ownerLegalEntityId String      @map("owner_legal_entity_id")
  code               String
  partyType          PartyType   @map("party_type")
  /// ORGANISATION: registered/legal name. INDIVIDUAL: unused (NULL).
  legalName          String?     @map("legal_name")
  tradingName        String?     @map("trading_name")
  /// INDIVIDUAL: given/family name. ORGANISATION: unused (NULL).
  givenName          String?     @map("given_name")
  familyName         String?     @map("family_name")
  /// Lower-cased, whitespace-collapsed display name. Duplicate DETECTION
  /// support only - indexed, never unique, and never used to auto-merge.
  normalisedName     String      @map("normalised_name")
  /// Counterparty tax/registration identifier. Deliberately opaque with no
  /// format validation - every SG/MY/ID identifier format is still
  /// RESEARCH REQUIRED in the country requirement documents, matching
  /// LegalEntity.registeredIdentifier's own treatment.
  taxIdentifier      String?     @map("tax_identifier")
  status             PartyStatus @default(ACTIVE)
  archivedAt         DateTime?   @map("archived_at") @db.Timestamptz(3)
  version            Int         @default(1)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerLegalEntity LegalEntity                  @relation("PartyOwner", fields: [ownerLegalEntityId, tenantId], references: [id, tenantId], onDelete: NoAction)
  contacts         PartyContact[]
  addresses        PartyAddress[]
  assignments      PartyLegalEntityAssignment[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, normalisedName])
  @@index([tenantId, taxIdentifier])
  @@index([tenantId, ownerLegalEntityId])
  @@map("party")
}

/// An EXTERNAL business contact at a counterparty. This is not, and must never
/// become, an authentication identity: it has no credential, session or
/// account relation, and its email is deliberately not unique against
/// User.email. See PHASE_02_IMPLEMENTATION.md's identity-boundary table.
model PartyContact {
  id              String      @id @default(cuid())
  tenantId        String      @map("tenant_id")
  partyId         String      @map("party_id")
  givenName       String      @map("given_name")
  familyName      String?     @map("family_name")
  jobTitle        String?     @map("job_title")
  email           String?
  phone           String?
  isPrimary       Boolean     @default(false) @map("is_primary")
  /// Lower-cased email for duplicate detection only.
  normalisedEmail String?     @map("normalised_email")
  status          PartyStatus @default(ACTIVE)
  archivedAt      DateTime?   @map("archived_at") @db.Timestamptz(3)
  version         Int         @default(1)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  party  Party  @relation(fields: [partyId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId])
  @@index([partyId])
  @@index([tenantId, normalisedEmail])
  @@map("party_contact")
}

/// Descriptive postal address. `countryCode` is an ISO 3166-1 alpha-2 SHAPE
/// only (two uppercase letters, DB-enforced) and is deliberately NOT the
/// `Jurisdiction` enum: a NoahArk legal entity is strictly SG/MY/ID, but its
/// counterparties may be anywhere. This column must never select a
/// localisation, tax, payroll, holiday, language or statutory adapter -
/// enforced by apps/web/lib/addressCountryAdapterBoundary.test.ts.
model PartyAddress {
  id          String           @id @default(cuid())
  tenantId    String           @map("tenant_id")
  partyId     String           @map("party_id")
  addressType PartyAddressType @map("address_type")
  line1       String
  line2       String?
  line3       String?
  city        String?
  region      String?
  postalCode  String?          @map("postal_code")
  countryCode String           @map("country_code") @db.Char(2)
  status      PartyStatus      @default(ACTIVE)
  archivedAt  DateTime?        @map("archived_at") @db.Timestamptz(3)
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  party  Party  @relation(fields: [partyId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId])
  @@index([partyId])
  @@map("party_address")
}

/// The isolation boundary for shared party master data. Composite foreign
/// keys to BOTH `party(id, tenant_id)` and `legal_entity(id, tenant_id)` make
/// a cross-tenant assignment structurally impossible, not merely validated.
model PartyLegalEntityAssignment {
  id            String           @id @default(cuid())
  tenantId      String           @map("tenant_id")
  partyId       String           @map("party_id")
  legalEntityId String           @map("legal_entity_id")
  status        AssignmentStatus @default(ACTIVE)
  assignedAt    DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(3)
  archivedAt    DateTime?        @map("archived_at") @db.Timestamptz(3)
  version       Int              @default(1)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  party        Party         @relation(fields: [partyId, tenantId], references: [id, tenantId], onDelete: Cascade)
  legalEntity  LegalEntity   @relation(fields: [legalEntityId, tenantId], references: [id, tenantId], onDelete: Cascade)
  customerRole CustomerRole?
  vendorRole   VendorRole?

  @@unique([partyId, legalEntityId])
  @@unique([id, legalEntityId])
  @@index([tenantId, legalEntityId])
  @@index([partyId, legalEntityId])
  @@map("party_legal_entity_assignment")
}

/// Customer role for ONE legal entity. Deliberately minimal: no credit limit,
/// no payment-term reference, no tax-profile reference and no default price
/// list - each of those implies receivables, terms calculation, tax
/// determination or customer-specific pricing, all excluded from Phase 2.
model CustomerRole {
  id              String           @id @default(cuid())
  tenantId        String           @map("tenant_id")
  legalEntityId   String           @map("legal_entity_id")
  assignmentId    String           @map("assignment_id")
  code            String
  status          AssignmentStatus @default(ACTIVE)
  defaultCurrency Currency?        @map("default_currency")
  archivedAt      DateTime?        @map("archived_at") @db.Timestamptz(3)
  version         Int              @default(1)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity                @relation(fields: [legalEntityId, tenantId], references: [id, tenantId], onDelete: Cascade)
  assignment  PartyLegalEntityAssignment @relation(fields: [assignmentId, legalEntityId], references: [id, legalEntityId], onDelete: Cascade)

  @@unique([assignmentId])
  @@unique([assignmentId, legalEntityId])
  @@unique([legalEntityId, code])
  @@index([tenantId, legalEntityId])
  @@map("customer_role")
}

/// Vendor role for ONE legal entity - symmetric with CustomerRole. A single
/// assignment may carry BOTH roles, which is how one organisation is both a
/// customer and a supplier of the same entity without duplication.
model VendorRole {
  id              String           @id @default(cuid())
  tenantId        String           @map("tenant_id")
  legalEntityId   String           @map("legal_entity_id")
  assignmentId    String           @map("assignment_id")
  code            String
  status          AssignmentStatus @default(ACTIVE)
  defaultCurrency Currency?        @map("default_currency")
  archivedAt      DateTime?        @map("archived_at") @db.Timestamptz(3)
  version         Int              @default(1)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity                @relation(fields: [legalEntityId, tenantId], references: [id, tenantId], onDelete: Cascade)
  assignment  PartyLegalEntityAssignment @relation(fields: [assignmentId, legalEntityId], references: [id, legalEntityId], onDelete: Cascade)

  @@unique([assignmentId])
  @@unique([assignmentId, legalEntityId])
  @@unique([legalEntityId, code])
  @@index([tenantId, legalEntityId])
  @@map("vendor_role")
}

// ---------------------------------------------------------------------------
// Phase 2 - Catalog and pricing
// ---------------------------------------------------------------------------

/// Flat in Phase 2 (no parentId). A nullable self-reference can be added
/// later without a destructive migration if hierarchy is ever required.
/// Tenant-visible reference data: carries no entity-specific commercial term,
/// so it uses the plain tenant policy rather than an assignment policy.
model CatalogCategory {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  CatalogItem[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@map("catalog_category")
}

/// Base unit only - no conversion factors and no conversion engine in Phase 2.
/// Tenant-visible reference data, as for categories.
model UnitOfMeasure {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  CatalogItem[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@map("unit_of_measure")
}

/// One model for products AND services: every behavioural difference between
/// them in this codebase - stock, costing, serial/batch, BOM - is excluded
/// from Phase 2, so two tables would duplicate categories, UOM, assignments,
/// pricing and custom fields for no gain.
///
/// Deliberately ABSENT: stock quantity, valuation, movement, isStockTracked,
/// variants and any accounting mapping. The Phase 2 schema test asserts their
/// continued absence.
///
/// `ownerLegalEntityId` is the managing legal entity (ADR-73). Assignments
/// grant additional read visibility; they do not grant mutation of shared
/// catalog fields.
model CatalogItem {
  id                 String          @id @default(cuid())
  tenantId           String          @map("tenant_id")
  ownerLegalEntityId String          @map("owner_legal_entity_id")
  code               String
  itemType           CatalogItemType @map("item_type")
  name               String
  description        String?
  categoryId         String?         @map("category_id")
  baseUomId          String          @map("base_uom_id")
  /// INERT placeholder required by IMPLEMENTATION_ROADMAP.md's Phase 2
  /// "Tax-mapping placeholders" country-impact note. No Phase 2 code reads
  /// it and no tax logic may consume it - tax determination is the country
  /// adapter's job in Phases 11-13.
  taxCategoryCode    String?         @map("tax_category_code")
  isSellable         Boolean         @default(true) @map("is_sellable")
  isPurchasable      Boolean         @default(true) @map("is_purchasable")
  status             PartyStatus     @default(ACTIVE)
  archivedAt         DateTime?       @map("archived_at") @db.Timestamptz(3)
  version            Int             @default(1)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant                             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerLegalEntity LegalEntity                        @relation("CatalogItemOwner", fields: [ownerLegalEntityId, tenantId], references: [id, tenantId], onDelete: NoAction)
  category         CatalogCategory?                   @relation(fields: [categoryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  baseUom          UnitOfMeasure                      @relation(fields: [baseUomId, tenantId], references: [id, tenantId], onDelete: Restrict)
  assignments      CatalogItemLegalEntityAssignment[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, itemType])
  @@index([tenantId, ownerLegalEntityId])
  @@map("catalog_item")
}

model CatalogItemLegalEntityAssignment {
  id             String           @id @default(cuid())
  tenantId       String           @map("tenant_id")
  catalogItemId  String           @map("catalog_item_id")
  legalEntityId  String           @map("legal_entity_id")
  /// Optional entity-local code; unique per legal entity when present
  /// (partial unique index - see the Phase 2 migration).
  entityItemCode String?          @map("entity_item_code")
  status         AssignmentStatus @default(ACTIVE)
  assignedAt     DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(3)
  archivedAt     DateTime?        @map("archived_at") @db.Timestamptz(3)
  version        Int              @default(1)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  catalogItem  CatalogItem      @relation(fields: [catalogItemId, tenantId], references: [id, tenantId], onDelete: Cascade)
  legalEntity  LegalEntity      @relation(fields: [legalEntityId, tenantId], references: [id, tenantId], onDelete: Cascade)
  priceEntries PriceListEntry[]

  @@unique([catalogItemId, legalEntityId])
  @@unique([id, legalEntityId])
  @@index([tenantId, legalEntityId])
  @@index([catalogItemId, legalEntityId])
  @@map("catalog_item_legal_entity_assignment")
}

/// Currency is the platform `Currency` enum (SGD/MYR/IDR) - PRODUCT_SCOPE.md
/// section 2 forbids an unrestricted currency catalogue.
///
/// `ownerLegalEntityId` is the managing legal entity (ADR-73). Price-list
/// assignment rows and PriceListEntry remain governed by their own
/// legalEntityId; they cannot be used to mutate this shared master.
model PriceList {
  id                 String      @id @default(cuid())
  tenantId           String      @map("tenant_id")
  ownerLegalEntityId String      @map("owner_legal_entity_id")
  code               String
  name               String
  currency           Currency
  status             PartyStatus @default(ACTIVE)
  archivedAt         DateTime?   @map("archived_at") @db.Timestamptz(3)
  version            Int         @default(1)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerLegalEntity LegalEntity                      @relation("PriceListOwner", fields: [ownerLegalEntityId, tenantId], references: [id, tenantId], onDelete: NoAction)
  assignments      PriceListLegalEntityAssignment[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, ownerLegalEntityId])
  @@map("price_list")
}

model PriceListLegalEntityAssignment {
  id            String           @id @default(cuid())
  tenantId      String           @map("tenant_id")
  priceListId   String           @map("price_list_id")
  legalEntityId String           @map("legal_entity_id")
  /// At most one ACTIVE default per legal entity - partial unique index.
  isDefault     Boolean          @default(false) @map("is_default")
  status        AssignmentStatus @default(ACTIVE)
  assignedAt    DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(3)
  archivedAt    DateTime?        @map("archived_at") @db.Timestamptz(3)
  version       Int              @default(1)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceList   PriceList        @relation(fields: [priceListId, tenantId], references: [id, tenantId], onDelete: Cascade)
  legalEntity LegalEntity      @relation(fields: [legalEntityId, tenantId], references: [id, tenantId], onDelete: Cascade)
  entries     PriceListEntry[]

  @@unique([priceListId, legalEntityId])
  @@unique([id, legalEntityId])
  @@index([tenantId, legalEntityId])
  @@map("price_list_legal_entity_assignment")
}

/// A price is owned by exactly ONE legal entity, structurally. Both foreign
/// keys carry `legal_entity_id` in the key itself, so a row can only ever
/// reference a price-list assignment and a catalog-item assignment that
/// belong to the SAME legal entity as the row - a mismatch is rejected by
/// PostgreSQL, not by application code, and cannot be forged through raw SQL.
model PriceListEntry {
  id                      String    @id @default(cuid())
  tenantId                String    @map("tenant_id")
  legalEntityId           String    @map("legal_entity_id")
  priceListAssignmentId   String    @map("price_list_assignment_id")
  catalogItemAssignmentId String    @map("catalog_item_assignment_id")
  /// Exact decimal (ADR-71). Never a float; never scientific notation at a
  /// future API boundary; CHECK unit_price >= 0.
  unitPrice               Decimal   @map("unit_price") @db.Decimal(23, 6)
  /// LOCAL_CIVIL_DATE - a price effective "1 July" means 1 July everywhere.
  effectiveFrom           DateTime  @map("effective_from") @db.Date
  effectiveTo             DateTime? @map("effective_to") @db.Date
  version                 Int       @default(1)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant                Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity           LegalEntity                      @relation(fields: [legalEntityId, tenantId], references: [id, tenantId], onDelete: Cascade)
  priceListAssignment   PriceListLegalEntityAssignment   @relation(fields: [priceListAssignmentId, legalEntityId], references: [id, legalEntityId], onDelete: Cascade)
  catalogItemAssignment CatalogItemLegalEntityAssignment @relation(fields: [catalogItemAssignmentId, legalEntityId], references: [id, legalEntityId], onDelete: Cascade)

  @@index([tenantId, legalEntityId])
  @@index([priceListAssignmentId, catalogItemAssignmentId])
  @@map("price_list_entry")
}
