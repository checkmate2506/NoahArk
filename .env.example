# NoahArk — environment template. Copy to .env and fill in local values.
# NEVER commit a real .env file.

# --- Database -----------------------------------------------------------
# N-3 (Phase 1D): these three connections are scoped to different PROCESSES,
# not interchangeable. The Next.js app process (`next build`/`next start`)
# reads ONLY DATABASE_URL — packages/config's env schema does not declare
# the other two, so the app cannot even boot with elevated credentials it
# has no legitimate use for. See docs/PHASE_01_IMPLEMENTATION.md's
# "Runtime credential boundary" section.

# Application connection — MUST use the non-superuser app role created by the
# migrations (noahark_app), so PostgreSQL Row-Level Security cannot be
# bypassed. Required by: `next build`, `next start`, `next dev`.
DATABASE_URL="postgresql://noahark_app:noahark_app@localhost:5432/noahark?schema=public"

# Superuser-ish connection used ONLY for running migrations (DDL, creates the
# non-superuser app roles, installs RLS policies), `prisma/seed.ts`, and
# `provisioning/provision-roles.mjs`. Never read by the running app or the
# worker — do NOT set this in the Next.js app's or worker's deployed
# environment; it is a one-shot/administrative credential only.
DATABASE_MIGRATION_URL="postgresql://postgres:postgres@localhost:5432/noahark?schema=public"

# Background-worker connection — a role with GRANTs limited to only the
# background_job and outbox_event queue tables (see the RLS migration,
# packages/db/src/workerClient.ts). Used exclusively by `tsx scripts/worker.ts`
# to poll for work across tenants; the worker switches to DATABASE_URL
# (RLS-enforced) for all business-data access while actually executing a
# job. Not read by `next build`/`next start` — only by the separate worker
# process.
DATABASE_WORKER_URL="postgresql://noahark_worker:noahark_worker@localhost:5432/noahark?schema=public"

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32 — the placeholder below is
# deliberately REJECTED at startup (F-1B/F-10: packages/config's env
# schema refuses known-placeholder and low-entropy values), so this is not
# an oversight to fix later — you must replace it before the app will boot.
AUTH_SECRET="replace-with-a-real-random-secret"
# Must exactly match the origin (scheme+host+port) the app is actually
# reached at — it's also used as the trusted origin for CSRF Origin-header
# validation (F-8, apps/web/lib/csrf.ts). If you run the dev server on a
# different port (this repo's own development used 3100, since 3000 was
# occupied by an unrelated local service), update this to match or every
# state-changing API request will be rejected as untrusted.
AUTH_URL="http://localhost:3000"
# Optional comma-separated list of additional trusted origins for CSRF
# Origin validation (F-8) — rarely needed in Phase 1 (no cross-origin
# clients exist yet).
TRUSTED_ORIGINS=""

# Number of trusted reverse-proxy hops in front of this app (F-9) — used to
# safely extract the real client IP from X-Forwarded-For for rate limiting.
# "0" (default) means no proxy is trusted and IP-dimension rate limiting is
# disabled (email-dimension limiting still applies) — set this to match your
# actual deployment topology (e.g. "1" behind a single load balancer/App
# Gateway hop). Never guess a nonzero value without confirming the topology —
# an incorrect count lets a client spoof the extracted IP.
TRUSTED_PROXY_COUNT="0"

# E2E test-only email capture (F-14/E2E) — must be exactly "1" to activate,
# and is ALSO gated on NODE_ENV !== "production" in code, so this is inert
# in any real deployment even if left set by mistake. Only ever set this in
# a local/CI E2E environment file, never in a real .env.
TEST_NOTIFICATION_CAPTURE=""

# --- Files (local dev provider) -------------------------------------------
FILES_LOCAL_ROOT="./.data/files"

# --- Notifications (dev-safe) ----------------------------------------------
# "console" logs emails to stdout instead of sending them. Production provider
# selection is deferred (AD-3) — do not point this at a real SMTP/API provider.
EMAIL_PROVIDER="console"

# --- App --------------------------------------------------------------------
NODE_ENV="development"
LOG_LEVEL="info"

# --- Demo seeding (F-1) -----------------------------------------------------
# Required (every run, not a one-time flag) to allow `pnpm db:seed` to run at
# all. The seed script additionally refuses NODE_ENV=production and any
# DATABASE_MIGRATION_URL whose host/database name looks production-like.
# Never set this in a staging/production environment file.
ALLOW_DEMO_SEED="1"
